# Backend environment variables
# ye file .env ke naam se copy karo aur apni values daalo

PORT=5000

# MongoDB Atlas connection string (Atlas -> Connect -> Drivers)
MONGO_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/luxurystay

# JWT secret - koi lamba random string
JWT_SECRET=change_this_to_a_long_random_string

# Cloudinary (production me image upload ke liye zaroori)
# https://cloudinary.com -> Dashboard -> API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
